{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "composite": true,
    "outDir": "node_modules/.cache/tsc",
    "types": ["vite/client"]
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/types.ts",
    "vite.config.ts"
  ]
}
