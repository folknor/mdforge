{
  "name": "mdforge-workspace",
  "private": true,
  "description": "Convert Markdown to beautifully styled PDFs.",
  "homepage": "https://github.com/folknor/mdforge",
  "license": "MIT",
  "author": {
    "name": "folknor",
    "url": "https://github.com/folknor"
  },
  "contributors": [
    {
      "name": "Simon Haenisch",
      "url": "https://github.com/simonhaenisch"
    }
  ],
  "repository": "folknor/mdforge",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "dev": "pnpm -r run dev",
    "lint": "oxlint",
    "fmt": "oxfmt . '!packages/core/src/data/google-fonts.json'",
    "fmt:check": "oxfmt --check . '!packages/core/src/data/google-fonts.json'",
    "desktop": "pnpm --filter @mdforge/desktop run dev",
    "regenerate-examples": "node scripts/regenerate-examples.js",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0"
  },
  "engines": {
    "node": ">=25.0",
    "pnpm": ">=11.0"
  }
}
