{
  "dependencies": {
    "@mdforge/core": "workspace:*",
    "@mdforge/pdf": "workspace:*"
  },
  "description": "Electron-based renderer for mdforge (no Puppeteer required)",
  "devDependencies": {
    "@types/node": "^25.9.3",
    "electron": "^42.4.0",
    "typescript": "6.0.3"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "default": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    }
  },
  "files": [
    "/dist"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@mdforge/renderer-electron",
  "peerDependencies": {
    "electron": "^42.4.0"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "1.0.0"
}
