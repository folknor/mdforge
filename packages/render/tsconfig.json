{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    // As in core: tests run the sources under Node's type stripping, so
    // sources import siblings by their .ts names and use only erasable syntax.
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
